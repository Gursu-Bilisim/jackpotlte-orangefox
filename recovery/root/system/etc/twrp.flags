# mount point	fstype		device			device2			flags

# Main system partitions (RAW)
/system_root    ext4 /dev/block/by-name/SYSTEM   flags=backup=1;wipeingui;display="System"
/vendor         ext4 /dev/block/by-name/VENDOR   flags=backup=1;wipeingui;display="Vendor"
/product        ext4 /dev/block/by-name/PRODUCT  flags=backup=1;wipeingui;display="Product"
/odm	        ext4 /dev/block/by-name/ODM      flags=backup=1;wipeingui;display="ODM"
/prism	        ext4 /dev/block/by-name/PRISM    flags=backup=1;wipeingui;display="Prism"
/optics	        ext4 /dev/block/by-name/OPTICS   flags=backup=1;wipeingui;display="Optics"

# Main system partitions (Images)
/system_image   emmc /dev/block/by-name/SYSTEM  flags=backup=1;flashimg;display="System Image"
/vendor_image   emmc /dev/block/by-name/VENDOR  flags=backup=1;flashimg;display="Vendor Image"
/product_image  emmc /dev/block/by-name/PRODUCT  flags=backup=1;flashimg;display="Product Image"
/odm_image  emmc /dev/block/by-name/ODM  flags=backup=1;flashimg;display="ODM Image"
/prism_image  emmc /dev/block/by-name/PRISM  flags=backup=1;flashimg;display="Prism Image"
/optics_image  emmc /dev/block/by-name/OPTICS  flags=backup=1;flashimg;display="Optics Image"

# Misc partitions
/boot		    emmc		/dev/block/by-name/BOOT
/recovery	    emmc		/dev/block/by-name/RECOVERY		flags=backup=1

/cache		    ext4		/dev/block/by-name/CACHE
/efs		    ext4		/dev/block/by-name/EFS		    flags=backup=1;display="EFS"

# OMR
/omr		    ext4		/dev/block/by-name/OMR		    flags=wipeingui;display="OMR"

# Removable storage
/external_sd	vfat	/dev/block/mmcblk1p1	/dev/block/mmcblk1		flags=storage;wipeingui;removable
/usb_otg	auto	/dev/block/sda1	/dev/block/sda				flags=display="USB-OTG";storage;wipeingui;removable
