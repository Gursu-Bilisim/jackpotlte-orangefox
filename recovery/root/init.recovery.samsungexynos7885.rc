on fs
    start hwservicemanager
    export ANDROID_ROOT /system_root

on init
    write /proc/sys/kernel/hung_task_timeout_secs 0
    exec u:r:recovery:s0 -- /system/bin/link.sh

service hwservicemanager /system/bin/hwservicemanager
    user root
    group root
    disabled
    onrestart setprop hwservicemanager.ready false
    seclabel u:r:recovery:s0

on boot
    start health-hal-2-1

    # OrangeFox flashlight: expose the Samsung rear flash as an LED directory
    mkdir /tmp/flashlight
    write /tmp/flashlight/max_brightness "1"
    symlink /sys/class/camera/flash/rear_flash /tmp/flashlight/brightness
